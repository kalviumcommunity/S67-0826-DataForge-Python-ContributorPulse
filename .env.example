# ==============================================================================
# ContributorPulse Environment Configuration
# ==============================================================================

# Application Environment (development, testing, staging, production)
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME=ContributorPulse

# Security & CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://127.0.0.1:8501

# GitHub API Credentials
# Used for ingestion and repository activity analysis (never commit real tokens)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# PostgreSQL Docker & Database Configuration
POSTGRES_DB=contributor_pulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# PostgreSQL Database Connection URL
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contributor_pulse

# Logging
LOG_LEVEL=INFO
